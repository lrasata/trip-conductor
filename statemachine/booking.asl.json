{
  "Comment": "The booking saga, up to the hotel: reserve the flight, then the hotel, or release what's held in reverse. The trip ID is the execution name.",
  "StartAt": "PublishTripRequested",
  "TimeoutSeconds": 900,
  "States": {
    "PublishTripRequested": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "TimeoutSeconds": 10,
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${event_bus_name}",
            "Source": "trip-conductor.booking-saga",
            "DetailType": "TripRequested",
            "Detail": {
              "message_id.$": "States.UUID()",
              "message_kind": "event",
              "message_type": "TripRequested",
              "message_version": 1,
              "occurred_at.$": "$$.State.EnteredTime",
              "correlation_id.$": "$$.Execution.Name",
              "producer": "booking-saga",
              "data": {
                "customer_id.$": "$.customer_id",
                "flight_offer_id.$": "$.flight.offer_id",
                "hotel_offer_id.$": "$.hotel.offer_id",
                "requested_at.$": "$$.Execution.StartTime"
              }
            }
          }
        ]
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "ReserveFlight"
    },
    "ReserveFlight": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "TimeoutSeconds": 20,
      "Parameters": {
        "QueueUrl": "${flight_queue_url}",
        "MessageBody": {
          "message_id.$": "States.UUID()",
          "message_kind": "command",
          "message_type": "ReserveFlight",
          "message_version": 1,
          "occurred_at.$": "$$.State.EnteredTime",
          "correlation_id.$": "$$.Execution.Name",
          "producer": "booking-saga",
          "task_token.$": "$$.Task.Token",
          "data": {
            "offer_id.$": "$.flight.offer_id",
            "passengers.$": "$.flight.passengers"
          }
        }
      },
      "ResultPath": "$.flight_reservation",
      "Retry": [
        {
          "ErrorEquals": ["VendorUnavailable"],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["FlightUnavailable"],
          "ResultPath": "$.error",
          "Next": "FlightUnavailable"
        },
        {
          "ErrorEquals": ["VendorUnavailable"],
          "ResultPath": "$.error",
          "Next": "AirlineUnavailable"
        },
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.error",
          "Next": "ReserveFlightTimedOut"
        }
      ],
      "Next": "ReserveHotel"
    },
    "FlightUnavailable": {
      "Type": "Pass",
      "Result": { "reason": "FLIGHT_UNAVAILABLE", "failed_step": "ReserveFlight" },
      "ResultPath": "$.cancellation",
      "Next": "PublishTripCancelled"
    },
    "AirlineUnavailable": {
      "Comment": "The hold, if the airline placed one, expires on its own: a release would hit the same outage.",
      "Type": "Pass",
      "Result": { "reason": "VENDOR_UNAVAILABLE", "failed_step": "ReserveFlight" },
      "ResultPath": "$.cancellation",
      "Next": "PublishTripCancelled"
    },
    "ReserveFlightTimedOut": {
      "Comment": "The service may still act on the command, so the flight is released even without a reservation.",
      "Type": "Pass",
      "Result": { "reason": "TIMEOUT", "failed_step": "ReserveFlight" },
      "ResultPath": "$.cancellation",
      "Next": "ReleaseFlight"
    },
    "ReserveHotel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "TimeoutSeconds": 20,
      "Parameters": {
        "QueueUrl": "${hotel_queue_url}",
        "MessageBody": {
          "message_id.$": "States.UUID()",
          "message_kind": "command",
          "message_type": "ReserveHotel",
          "message_version": 1,
          "occurred_at.$": "$$.State.EnteredTime",
          "correlation_id.$": "$$.Execution.Name",
          "producer": "booking-saga",
          "task_token.$": "$$.Task.Token",
          "data": {
            "offer_id.$": "$.hotel.offer_id",
            "check_in.$": "$.hotel.check_in",
            "check_out.$": "$.hotel.check_out",
            "guests.$": "$.hotel.guests"
          }
        }
      },
      "ResultPath": "$.hotel_reservation",
      "Retry": [
        {
          "ErrorEquals": ["VendorUnavailable"],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["HotelUnavailable"],
          "ResultPath": "$.error",
          "Next": "HotelUnavailable"
        },
        {
          "ErrorEquals": ["VendorUnavailable"],
          "ResultPath": "$.error",
          "Next": "HotelProviderUnavailable"
        },
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.error",
          "Next": "ReserveHotelTimedOut"
        }
      ],
      "Next": "ReleaseForTesting"
    },
    "HotelUnavailable": {
      "Type": "Pass",
      "Result": { "reason": "HOTEL_UNAVAILABLE", "failed_step": "ReserveHotel" },
      "ResultPath": "$.cancellation",
      "Next": "ReleaseFlight"
    },
    "HotelProviderUnavailable": {
      "Comment": "As for the airline: the room hold, if any, expires on its own. The flight is released.",
      "Type": "Pass",
      "Result": { "reason": "VENDOR_UNAVAILABLE", "failed_step": "ReserveHotel" },
      "ResultPath": "$.cancellation",
      "Next": "ReleaseFlight"
    },
    "ReserveHotelTimedOut": {
      "Type": "Pass",
      "Result": { "reason": "TIMEOUT", "failed_step": "ReserveHotel" },
      "ResultPath": "$.cancellation",
      "Next": "ReleaseHotel"
    },
    "ReleaseForTesting": {
      "Comment": "Temporary: nothing releases both holds until the payment step exists.",
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.release_after_reserve", "IsPresent": true },
            { "Variable": "$.release_after_reserve", "BooleanEquals": true }
          ],
          "Next": "TestRelease"
        }
      ],
      "Default": "TripHeld"
    },
    "TripHeld": {
      "Comment": "Temporary end of the saga: the holds expire on their own.",
      "Type": "Succeed"
    },
    "TestRelease": {
      "Type": "Pass",
      "Result": { "reason": "TEST_RELEASE", "failed_step": "ReleaseForTesting" },
      "ResultPath": "$.cancellation",
      "Next": "ReleaseHotel"
    },
    "ReleaseHotel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "TimeoutSeconds": 20,
      "Parameters": {
        "QueueUrl": "${hotel_queue_url}",
        "MessageBody": {
          "message_id.$": "States.UUID()",
          "message_kind": "command",
          "message_type": "ReleaseHotel",
          "message_version": 1,
          "occurred_at.$": "$$.State.EnteredTime",
          "correlation_id.$": "$$.Execution.Name",
          "producer": "booking-saga",
          "task_token.$": "$$.Task.Token",
          "data": {
            "reason.$": "$.cancellation.reason"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["VendorUnavailable", "States.Timeout"],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CompensationFailed"
        }
      ],
      "Next": "ReleaseFlight"
    },
    "ReleaseFlight": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "TimeoutSeconds": 20,
      "Parameters": {
        "QueueUrl": "${flight_queue_url}",
        "MessageBody": {
          "message_id.$": "States.UUID()",
          "message_kind": "command",
          "message_type": "ReleaseFlight",
          "message_version": 1,
          "occurred_at.$": "$$.State.EnteredTime",
          "correlation_id.$": "$$.Execution.Name",
          "producer": "booking-saga",
          "task_token.$": "$$.Task.Token",
          "data": {
            "reason.$": "$.cancellation.reason"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["VendorUnavailable", "States.Timeout"],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CompensationFailed"
        }
      ],
      "Next": "PublishTripCancelled"
    },
    "CompensationFailed": {
      "Comment": "A failed execution fires the alarm. The holds expire on their own as the last safety net.",
      "Type": "Fail",
      "Error": "CompensationFailed",
      "Cause": "A release still failed after its retries."
    },
    "PublishTripCancelled": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "TimeoutSeconds": 10,
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${event_bus_name}",
            "Source": "trip-conductor.booking-saga",
            "DetailType": "TripCancelled",
            "Detail": {
              "message_id.$": "States.UUID()",
              "message_kind": "event",
              "message_type": "TripCancelled",
              "message_version": 1,
              "occurred_at.$": "$$.State.EnteredTime",
              "correlation_id.$": "$$.Execution.Name",
              "producer": "booking-saga",
              "data": {
                "customer_id.$": "$.customer_id",
                "reason.$": "$.cancellation.reason",
                "failed_step.$": "$.cancellation.failed_step"
              }
            }
          }
        ]
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "TripCancelled"
    },
    "TripCancelled": {
      "Comment": "A cancelled trip is a business outcome, not a failed execution: it must not fire the alarm.",
      "Type": "Succeed"
    }
  }
}
